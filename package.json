    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^7.2.1",
    "prettier": "^3.5.3",
    "prisma": "^7.0.0",
    "supertest": "^7.3.1",
    "ts-node-dev": "^2.0.0",
